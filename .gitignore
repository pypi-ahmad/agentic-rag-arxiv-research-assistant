artifacts/faiss_index/*.pkl
artifacts/faiss_index/*.bin

# ── Agent trace logs (can be large JSON files) ────────────────────────────────
artifacts/agent_traces/*.json

# ── Raw dataset cache (re-downloadable from HuggingFace Hub) ─────────────────
data/
.cache/
~/.cache/huggingface/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
*.env

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS noise ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor configs ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
site/

